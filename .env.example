# Copy to .env for local development. NEVER commit the real .env file.
# In deployed Lambdas, these values are read from SSM Parameter Store at
# /${NAME_PREFIX}/dev/* — this file is for local/CI use only.

# --- AWS (local dev only; Lambdas use their execution role) ---
AWS_ACCOUNT_ID=000000000000
AWS_REGION=ap-south-1
ARTIFACT_BUCKET=cloudops-lite-000000000000

# --- Anthropic (never used in CI; tests use FakeChatModel) ---
ANTHROPIC_API_KEY=CHANGE_ME

# --- LangSmith (optional, SaaS free plan) ---
LANGSMITH_API_KEY=CHANGE_ME
LANGSMITH_PROJECT=cloudops-lite-dev
LANGSMITH_TRACING=false

# --- Slack (never used in CI; tests fake the client) ---
SLACK_BOT_TOKEN=CHANGE_ME
SLACK_SIGNING_SECRET=CHANGE_ME
SLACK_CHANNEL_ID=CHANGE_ME
APPROVER_SLACK_ID=CHANGE_ME

# --- GitHub (fine-grained PAT scoped to this repo only) ---
GH_OWNER=Abhiram-Rakesh
REPO_NAME=cloudops-agentic-orchestrator-lite
GITHUB_TOKEN=CHANGE_ME

# --- CLI ---
CLOUDOPS_CONFIG=config/settings.local.yaml
